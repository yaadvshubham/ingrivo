# Ingrivo Frontend — Environment Variables Template
# Copy this file to .env.local and fill in your real keys for deployment.

# Backend API Endpoint
NEXT_PUBLIC_API_BASE_URL=https://ingrivo-3.onrender.com

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General -> Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Gemini AI API Key (Server-Side Next.js Route Handler /api/chat — Never exposed to browser bundle)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
