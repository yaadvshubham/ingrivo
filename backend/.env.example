# Ingrivo Backend — Environment Variables
# Copy this file to .env and fill in the values.

# General
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Ingrivo/0.1.0 (https://github.com/ingrivo)

# Gemini (optional — leave blank to disable AI features)
GEMINI_API_KEY=
GEMINI_MODEL=
