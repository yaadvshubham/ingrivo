# Ingrivo Backend — Environment Variables
# Copy this file to .env and fill in the values.

# General
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Ingrivo/0.1.0 (yaadv@example.com)
OFF_API_VERSION=v3
OFF_STAGING_BASIC_AUTH=off:off
OFF_MAX_REQUESTS_PER_MIN=12
INBOUND_MAX_REQUESTS_PER_MIN=20

# Search (Search-a-licious)
SEARCH_BASE_URL=https://search.openfoodfacts.org
SEARCH_MAX_PER_MIN=8
INBOUND_SEARCH_MAX_PER_MIN=6

# Gemini (Phase 7: Structured AI Explanations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_MAX_CALLS_PER_DAY=100
EXPLAIN_RATE_LIMIT=5
MAX_EVIDENCE_CHARS=4000
