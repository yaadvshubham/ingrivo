# Pinfo Backend — Environment Variables
# Copy this file to .env and fill in the values.

# General
APP_ENV=development
ALLOWED_ORIGINS=https://trypinfo.vercel.app,https://pinfo.vercel.app,https://ingrivo.vercel.app,http://localhost:3000

# Open Food Facts
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Pinfo/0.1.0 (yaadv@example.com)
OFF_API_VERSION=v3
OFF_STAGING_BASIC_AUTH=off:off
OFF_MAX_REQUESTS_PER_MIN=12
INBOUND_MAX_REQUESTS_PER_MIN=20

# Search (Search-a-licious)
SEARCH_BASE_URL=https://search.openfoodfacts.org
SEARCH_MAX_PER_MIN=8
INBOUND_SEARCH_MAX_PER_MIN=6

# Gemini (Phase 7: Structured AI Explanations)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_MAX_CALLS_PER_DAY=100
EXPLAIN_RATE_LIMIT=5
MAX_EVIDENCE_CHARS=4000

# Super Admin Initialization (Optional overrides)
ADMIN_EMAIL=yaadvshubham01@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# SMTP Email Configuration (Optional - for welcome emails & alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ingrivo.com

